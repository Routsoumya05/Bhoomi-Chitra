{
  "name": "bhoomi-chitra",
  "version": "1.0.0",
  "description": "BHOOMI CHITRA: National Land Acquisition & Management System (Govt of India)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && node src/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd backend && node src/index.js",
    "test": "node test_flow.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "National Informatics Centre / SIH 2026 Team",
  "license": "ISC"
}
